 void Select::CalcSelectRadius(SelectCtx &ctx, int selection_type) {
-  const float scale = selection_type == SELTYPE_ROUTESEGMENT
-                          ? routeSegmentScale : 1.f;
+  double scale = selection_type == SELTYPE_ROUTESEGMENT
+                     ? routeSegmentScale : 1.f;
+  // pixelRadius is configured in raw pixels by native initialization. Only
+  // XNav's enlarged route target follows the querying canvas's DIP scale;
+  // Legacy and every other selectable type keep their original radius.
+  if (selection_type == SELTYPE_ROUTESEGMENT && routeSegmentScale > 1.f &&
+      std::isfinite(ctx.route_hit_dip_scale) && ctx.route_hit_dip_scale >= 1.0 &&
+      ctx.route_hit_dip_scale <= 4.0)
+    scale *= ctx.route_hit_dip_scale;
   selectRadius = pixelRadius * scale / (ctx.scale * 1852 * 60);
 }
 
