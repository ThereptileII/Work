+    SocketConnectionInfo Socket::getConnectionInfo()
+    {
+        std::lock_guard<std::mutex> lock(_socketMutex);
+        const int fd = _sockfd;
+        SocketConnectionInfo result;
+        if (fd == -1) return result;
+        sockaddr_storage local{}, remote{};
+        socklen_t localSize = sizeof(local), remoteSize = sizeof(remote);
+        if (getsockname(fd, reinterpret_cast<sockaddr*>(&local), &localSize) != 0 ||
+            getpeername(fd, reinterpret_cast<sockaddr*>(&remote), &remoteSize) != 0 ||
+            local.ss_family != remote.ss_family) return result;
+        if (local.ss_family == AF_INET && localSize >= sizeof(sockaddr_in) &&
+            remoteSize >= sizeof(sockaddr_in))
+        {
+            const auto& l = reinterpret_cast<const sockaddr_in&>(local);
+            const auto& r = reinterpret_cast<const sockaddr_in&>(remote);
+            memcpy(result.local.address.data(), &l.sin_addr, 4);
+            memcpy(result.remote.address.data(), &r.sin_addr, 4);
+            result.local.port = ntohs(l.sin_port);
+            result.remote.port = ntohs(r.sin_port);
+            result.family = SocketConnectionInfo::Family::IPv4;
+        }
+        else if (local.ss_family == AF_INET6 && localSize >= sizeof(sockaddr_in6) &&
+                 remoteSize >= sizeof(sockaddr_in6))
+        {
+            const auto& l = reinterpret_cast<const sockaddr_in6&>(local);
+            const auto& r = reinterpret_cast<const sockaddr_in6&>(remote);
+            memcpy(result.local.address.data(), &l.sin6_addr, 16);
+            memcpy(result.remote.address.data(), &r.sin6_addr, 16);
+            result.local.port = ntohs(l.sin6_port);
+            result.remote.port = ntohs(r.sin6_port);
+            result.local.scope = l.sin6_scope_id;
+            result.remote.scope = r.sin6_scope_id;
+            result.family = SocketConnectionInfo::Family::IPv6;
+        }
+        if (!result.local.port || !result.remote.port) return {};
+        result.capturedAt = std::chrono::steady_clock::now();
+        return result;
+    }
+
