+#pragma once
+#include <array>
+#include <chrono>
+#include <cstdint>
+
+namespace ix
+{
+    // Owned numeric values only. A capture is historical, never a liveness claim.
+    struct SocketEndpoint
+    {
+        std::array<uint8_t, 16> address{}; // network-order bytes; IPv4 uses first four
+        uint16_t port = 0;               // host order
+        uint32_t scope = 0;              // IPv6 scope ID; zero for IPv4
+    };
+    struct SocketConnectionInfo
+    {
+        enum class Family { Unavailable, IPv4, IPv6 };
+        Family family = Family::Unavailable;
+        SocketEndpoint local, remote;
+        std::chrono::steady_clock::time_point capturedAt{};
+    };
+}
