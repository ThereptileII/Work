+// Savepoints make a complete object update atomic both on its own and inside
+// an existing route/track transaction. Nested uses resolve the nearest marker.
+// No database schema or public NavObj_dB interface changes are required.
+class NavobjWriteScope {
+ public:
+  explicit NavobjWriteScope(sqlite3* db) : db_(db) {
+    active_ = executeSQL(db_, "SAVEPOINT navobj_object_write");
+  }
+  ~NavobjWriteScope() {
+    if (active_ && !sqlite3_get_autocommit(db_)) {
+      executeSQL(db_, "ROLLBACK TO navobj_object_write");
+      executeSQL(db_, "RELEASE navobj_object_write");
+    }
+  }
+  explicit operator bool() const { return active_; }
+  bool Commit() {
+    if (!active_ || !executeSQL(db_, "RELEASE navobj_object_write")) return false;
+    active_ = false;
+    return true;
+  }
+ private:
+  sqlite3* db_;
+  bool active_ = false;
+};
