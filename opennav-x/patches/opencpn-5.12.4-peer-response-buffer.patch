+// OPENNAV_PEER_REQUEST_INIT_BEGIN
+static CURL* InitPeerRequest(const MemoryStruct* response, CURLcode& result) {
+  result = CURLE_OK;
+  if (!response) {
+    result = CURLE_BAD_FUNCTION_ARGUMENT;
+    return nullptr;
+  }
+  if (!response->memory) {
+    result = CURLE_OUT_OF_MEMORY;
+    return nullptr;
+  }
+  CURL* curl = curl_easy_init();
+  if (!curl) result = CURLE_FAILED_INIT;
+  return curl;
+}
