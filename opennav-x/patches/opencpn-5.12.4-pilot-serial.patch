diff --git i/model/include/model/comm_drv_n2k_serial_framer.h w/model/include/model/comm_drv_n2k_serial_framer.h
new file mode 100644
index 0000000..cbf9116
--- /dev/null
+++ w/model/include/model/comm_drv_n2k_serial_framer.h
@@ -0,0 +1,34 @@
+#ifndef COMM_DRV_N2K_SERIAL_FRAMER_H
+#define COMM_DRV_N2K_SERIAL_FRAMER_H
+#include <chrono>
+#include <cstdint>
+#include <vector>
+// Complete bounded Actisense frames, timestamped at first chunk read (before
+// the blocking read). A partly received old frame cannot acknowledge a command.
+class N2kSerialFramer {
+public:
+  using Time = std::chrono::steady_clock::time_point;
+  void Reset() { data_.clear(); in_frame_ = escape_ = false; }
+  template<class Emit>
+  void Feed(const unsigned char* bytes, size_t size, Time at, uint64_t epoch, Emit emit) {
+    for (size_t i = 0; i < size; ++i) {
+      auto byte = bytes[i];
+      if (escape_) {
+        escape_ = false;
+        if (byte == 2) { data_.clear(); in_frame_ = true; at_ = at; epoch_ = epoch; continue; }
+        if (byte == 3 && in_frame_) { emit(data_, at_, epoch_); Reset(); continue; }
+        if (byte != 0x10) { Reset(); continue; }
+      } else if (byte == 0x10) { escape_ = true; continue; }
+      if (in_frame_) {
+        if (data_.size() >= 512) Reset();
+        else data_.push_back(byte);
+      }
+    }
+  }
+private:
+  std::vector<unsigned char> data_;
+  bool in_frame_ = false, escape_ = false;
+  Time at_{};
+  uint64_t epoch_ = 0;
+};
+#endif
diff --git i/model/include/model/comm_drv_n2k_serial_state.h w/model/include/model/comm_drv_n2k_serial_state.h
new file mode 100644
index 0000000..57e826e
--- /dev/null
+++ w/model/include/model/comm_drv_n2k_serial_state.h
@@ -0,0 +1,117 @@
+#ifndef COMM_DRV_N2K_SERIAL_STATE_H
+#define COMM_DRV_N2K_SERIAL_STATE_H
+#include <chrono>
+#include <cstdint>
+#include <deque>
+#include <limits>
+#include <mutex>
+#include <vector>
+#include <utility>
+
+// Shared by the application and serial worker. A queue result is never delivery
+// or physical acknowledgement. All state and the final write share one lock.
+class N2kSerialState {
+public:
+  using Clock = std::chrono::steady_clock;
+  struct Snapshot {
+    bool connected = false;
+    uint64_t epoch = 0;
+    Clock::time_point changed_at{};
+    uint64_t pilot_writes = 0;
+    uint64_t pilot_written_ticket = 0;
+    Clock::time_point pilot_written_at{};
+  };
+  Snapshot Get() const {
+    std::lock_guard<std::mutex> lock(mutex_);
+    return state_;
+  }
+  void Connection(bool connected) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    Transition(connected);
+  }
+  void EnablePilot(bool enabled) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    pilot_enabled_ = enabled && state_.connected;
+    // A disable/enable boundary can never retain an old command.
+    for (auto it = queue_.begin(); it != queue_.end();)
+      if (it->pilot) it = queue_.erase(it); else ++it;
+  }
+  bool Enqueue(const std::vector<unsigned char>& bytes, bool pilot = false,
+               uint64_t expected_epoch = 0, Clock::time_point now = Clock::now(),
+               bool session_required = true, bool replace_pilot = false,
+               uint64_t* ticket = nullptr) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    if (ticket) *ticket = 0;
+    if (pilot && next_ticket_ == (std::numeric_limits<uint64_t>::max)()) {
+      Transition(false); return false;
+    }
+    if (!state_.connected || bytes.empty() || bytes.size() > 512 ||
+        (pilot && ((session_required && !pilot_enabled_) || expected_epoch != state_.epoch))) return false;
+    if (pilot) {
+      for (auto it = queue_.begin(); it != queue_.end();) {
+        if (it->pilot) {
+          if (!replace_pilot) return false;
+          it = queue_.erase(it);
+        } else ++it;
+      }
+    }
+    if (queue_.size() >= 20) return false;
+    const auto assigned_ticket = pilot ? ++next_ticket_ : 0;
+    queue_.push_back({bytes, pilot, state_.epoch, now, session_required, assigned_ticket});
+    if (ticket) *ticket = assigned_ticket;
+    return true;
+  }
+  // 0: nothing eligible; 1: a complete write; -1: failed/partial write.
+  // Holding the lock linearizes disable/reconnect against write. The serial
+  // driver's bounded write timeout bounds the wait for a concurrent disable.
+  template<class Write>
+  int WriteOne(Write write, Clock::time_point now = Clock::now()) {
+    std::lock_guard<std::mutex> lock(mutex_);
+    while (!queue_.empty()) {
+      auto item = std::move(queue_.front()); queue_.pop_front();
+      if (!state_.connected || item.epoch != state_.epoch ||
+          (item.pilot && ((item.session_required && !pilot_enabled_) || now < item.queued ||
+                         now - item.queued >= std::chrono::milliseconds(500)))) continue;
+      size_t written = 0;
+      try { written = write(item.bytes); }
+      catch (...) { Transition(false); return -1; }
+      if (written == item.bytes.size()) {
+        if (item.pilot && item.session_required) {
+          if (state_.pilot_writes == (std::numeric_limits<uint64_t>::max)()) { Transition(false); return -1; }
+          ++state_.pilot_writes;
+          state_.pilot_written_ticket = item.ticket;
+          state_.pilot_written_at = Clock::now();
+        }
+        return 1;
+      }
+      // Never retry an uncertain write, and purge everything before reopen.
+      Transition(false);
+      return -1;
+    }
+    return 0;
+  }
+private:
+  struct Item {
+    std::vector<unsigned char> bytes;
+    bool pilot;
+    uint64_t epoch;
+    Clock::time_point queued;
+    bool session_required;
+    uint64_t ticket;
+  };
+  void Transition(bool connected) {
+    queue_.clear();
+    pilot_enabled_ = false;
+    if (state_.connected != connected) {
+      if (state_.epoch != (std::numeric_limits<uint64_t>::max)()) ++state_.epoch;
+      state_.changed_at = Clock::now();
+    }
+    state_.connected = connected && state_.epoch != (std::numeric_limits<uint64_t>::max)();
+  }
+  mutable std::mutex mutex_;
+  Snapshot state_;
+  bool pilot_enabled_ = false;
+  uint64_t next_ticket_ = 0;
+  std::deque<Item> queue_;
+};
+#endif
