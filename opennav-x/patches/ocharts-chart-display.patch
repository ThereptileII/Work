+void s52plib::ConfigurePresentationDisplay(bool veryLight, int percent) {
+  if (percent != 100 && percent != 125 && percent != 150) return;
+  const double scale = percent / 100.0;
+  if (m_presentationVeryLight == veryLight && m_presentationDisplayScale == scale)
+    return;
+  m_presentationVeryLight = veryLight;
+  m_presentationDisplayScale = scale;
+  // Native state-hash consumers invalidate retained chart/text caches; glyph
+  // caches also key their rendered size. Do not delete GL resources here.
+  ClearTextList();
+  GenerateStateHash();
+}
+
+S52color *s52plib::PresentationColor(ObjRazRules *object, const char *name,
+                                     bool area) {
+  const char *feature = object && object->obj ? object->obj->FeatureName : nullptr;
+  const bool linePrimitive =
+      object && object->obj && object->obj->Primitive_type == GEO_LINE;
+  if (area) return getColor(opennav::integration::VeryLightAreaColor(
+      m_presentationVeryLight, feature, name));
+  if (opennav::integration::VeryLightOrdinaryContour(
+          m_presentationVeryLight, feature, name, linePrimitive)) {
+    m_presentationContourColor = opennav::integration::FaintDepthContour(
+        *getColor(name), *getColor("DEPDW"));
+    return &m_presentationContourColor;
+  }
+  return getColor(name);
+}
