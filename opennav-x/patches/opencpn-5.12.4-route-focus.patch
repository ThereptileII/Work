+namespace {
+// A modal chart interaction must preserve its caller's completion policy.
+// XNav finishes explicitly; Legacy normally finishes on canvas focus loss.
+class RouteFinishFocusGuard {
+ public:
+  explicit RouteFinishFocusGuard(bool &finishOnFocusLoss)
+      : flag_(finishOnFocusLoss), previous_(finishOnFocusLoss) {
+    flag_ = false;
+  }
+  ~RouteFinishFocusGuard() { flag_ = previous_; }
+  RouteFinishFocusGuard(const RouteFinishFocusGuard &) = delete;
+  RouteFinishFocusGuard &operator=(const RouteFinishFocusGuard &) = delete;
+ private:
+  bool &flag_;
+  const bool previous_;
+};
+}  // namespace
