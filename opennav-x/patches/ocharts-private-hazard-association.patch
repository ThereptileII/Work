+#ifdef SKAGER_OCHARTS_ADAPTER
+// Bridge the original private chart query without exporting chart pointers or
+// extending PI/API17. Both containers are owned locally; objects remain borrowed.
+static std::list<S57Obj *> *SkagerAssociatedObjects(void *chart, S57Obj *obj)
+{
+    if (!chart || !obj || !obj->m_chart_context ||
+        obj->m_chart_context->chart != chart ||
+        obj->m_chart_context->get_associated_objects != &SkagerAssociatedObjects)
+        return nullptr;
+
+    std::unique_ptr<ListOfS57Obj> matches(
+        static_cast<eSENCChart *>(chart)->GetAssociatedObjects(obj));
+    if (!matches) return nullptr;
+    std::unique_ptr<std::list<S57Obj *>> result(new std::list<S57Obj *>);
+    for (ListOfS57Obj::Node *node = matches->GetFirst(); node; node = node->GetNext())
+        result->push_back(node->GetData());
+    return result.release();
+}
+#endif
