+template <typename T>
+static bool set_option(CURL* curl, CURLoption option, T value, int& errorcode,
+                       std::string& error_msg) {
+  const CURLcode code = curl_easy_setopt(curl, option, value);
+  if (code == CURLE_OK) return true;
+  errorcode = code;
+  error_msg = curl_easy_strerror(code);
+  return false;
+}
+
+static bool configure_public_https(CURL* curl, const std::string& url,
+                                   char* error_buffer, int& errorcode,
+                                   std::string& error_msg) {
+  if (url.size() < 8 || url.compare(0, 8, "https://") != 0) {
+    errorcode = CURLE_UNSUPPORTED_PROTOCOL;
+    error_msg = "Public download URL must use HTTPS";
+    return false;
+  }
+  if (!set_option(curl, CURLOPT_ERRORBUFFER, error_buffer, errorcode,
+                  error_msg) ||
+      !set_option(curl, CURLOPT_URL, url.c_str(), errorcode, error_msg) ||
+      !set_option(curl, CURLOPT_USERAGENT, "OpenCPN", errorcode, error_msg) ||
+      !set_option(curl, CURLOPT_SSL_VERIFYPEER, 1L, errorcode, error_msg) ||
+      !set_option(curl, CURLOPT_SSL_VERIFYHOST, 2L, errorcode, error_msg) ||
+      !set_option(curl, CURLOPT_PROTOCOLS_STR, "https", errorcode,
+                  error_msg) ||
+      !set_option(curl, CURLOPT_REDIR_PROTOCOLS_STR, "https", errorcode,
+                  error_msg) ||
+      !set_option(curl, CURLOPT_FOLLOWLOCATION, 1L, errorcode, error_msg) ||
+      !set_option(curl, CURLOPT_MAXREDIRS, 5L, errorcode, error_msg) ||
+      !set_option(curl, CURLOPT_FAILONERROR, 1L, errorcode, error_msg)) {
+    return false;
+  }
+#ifdef _WIN32
+  if (!set_option(curl, CURLOPT_SSL_OPTIONS, static_cast<long>(CURLSSLOPT_NATIVE_CA), errorcode,
+                  error_msg)) {
+    return false;
+  }
+#endif
+#ifdef OPENNAV_DOWNLOADER_TLS_TEST
+  const char* test_ca = std::getenv("OPENNAV_DOWNLOADER_TEST_CA_FILE");
+  if (test_ca == nullptr || test_ca[0] == '\0') {
+    errorcode = CURLE_SSL_CACERT_BADFILE;
+    error_msg = "Downloader TLS test CA is missing";
+    return false;
+  }
+  if (!set_option(curl, CURLOPT_CAINFO, test_ca, errorcode, error_msg)) {
+    return false;
+  }
+#endif
+  return true;
 }
 
